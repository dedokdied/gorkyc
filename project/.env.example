APP_ENV=dev
APP_TZ=Europe/Moscow

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/assistant

# Tests: отдельная БД, чтобы pytest не удалял данные dev/demo
TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/assistant_test

# Telegram MVP
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
BOT_MODE=polling
BOT_MOCK_MODE=false
BACKEND_URL=http://localhost:8000/api/v1
BOT_INTERNAL_SECRET=change-me

# LLM: API-first, любой OpenAI-compatible провайдер
LLM_PROVIDER=api
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1
LLM_TIMEOUT=60
# Локальный вариант: LLM_PROVIDER=ollama, LLM_MODEL=qwen2.5:3b,
# LLM_BASE_URL=http://localhost:11434/v1

# Voice: API-first, OpenAI-compatible /audio/transcriptions
STT_PROVIDER=api
STT_API_KEY=

STT_BASE_URL=https://api.openai.com/v1
STT_TIMEOUT=60
STT_LANGUAGE=ru
# Локальный вариант: STT_PROVIDER=faster-whisper, STT_MODEL=small,
# STT_DEVICE=cpu, STT_COMPUTE_TYPE=int8
TTS_PROVIDER=none

# Search
ENABLE_VECTOR_SEARCH=false
ENABLE_RERANK=false
EMBEDDINGS_PROVIDER=off

# Frontend (этап 2)
WEB_ORIGIN=http://localhost:5173
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_USE_MOCKS=true
