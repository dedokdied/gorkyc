APP_ENV=production
APP_TZ=Europe/Moscow

POSTGRES_DB=assistant
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+asyncpg://postgres:change-me@postgres:5432/assistant

TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
BOT_MODE=polling
BOT_MOCK_MODE=false
BACKEND_URL=http://api:8000/api/v1
BOT_INTERNAL_SECRET=change-me
REMINDERS_ENABLED=true
REMINDERS_INTERVAL_SECONDS=30

LLM_PROVIDER=api
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1
LLM_TIMEOUT=60

STT_PROVIDER=api
STT_API_KEY=

STT_BASE_URL=https://api.openai.com/v1
STT_TIMEOUT=60
STT_LANGUAGE=ru

TTS_PROVIDER=none

ENABLE_VECTOR_SEARCH=false
ENABLE_RERANK=false
EMBEDDINGS_PROVIDER=off

WEB_ORIGIN=https://example.com
WEB_PORT=8080
